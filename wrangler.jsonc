// https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"name": "otterhub",
	"compatibility_date": "2026-01-01",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./frontend/out"
	},
	"observability": {
		"enabled": true
	}
    "binding": "oh_file_url",
      "id": "a25cbb74922546faa51cc5fc21e792f3",
      
      // Optional: preview_id used when running `wrangler dev` for local dev
      "preview_id": "<ID_OF_PREVIEW_KV_NAMESPACE_FOR_LOCAL_DEVELOPMENT>"
}
